{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "dub.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "dub.agents",
          "providers": {
            "grok": {
              "enabled": true
            },
            "claude": {
              "enabled": false
            },
            "codex": {
              "enabled": false
            },
            "fireworks": {
              "enabled": false
            }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 900,
    "screensaver": 600
  },
  "plugins": [
    {
      "id": "dub.idle"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.idle"
  ],
  "cloneSourceRestores": [
    "dub.idle"
  ]
}
