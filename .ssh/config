Host ha
  HostName homeassistant.lan.podval.org
  User root

Host pve
  HostName 192.168.1.40
  User root

Host unifi
  HostName 192.168.1.184
  User root

Host docker
  HostName 192.168.1.187
  User root

Host *
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519_sk.pub
  IdentityAgent /run/user/1000/ssh-agent.socket
  ControlMaster		auto
  ControlPersist	5m
  # control directory needs to be created manually
  ControlPath		~/.ssh/control/ssh-%r@%h:%p