#!/bin/bash
# Install grok-bot Pulumi credentials on the cloud-infrastructure guest, under the
# filenames .envrc already reads. ssh host infra (Tailscale, YubiKey).
# Does not print file contents. The desktop .envrc keeps the terraform key and token.
set -euo pipefail

host=infra

# local path, then the guest path
secret_pairs=(
  Podval/Keys/grok-bot-podval-infra.json:Podval/Keys/terraform-podval-infra.json
  Podval/Keys/grok-bot-podval-cloudflare-api-token.txt:Podval/Keys/podval-cloudflare-api-token.txt
  OpenTorah/Keys/grok-bot-opentorah-infra.json:OpenTorah/Keys/terraform-opentorah-infra.json
  OpenTorah/Keys/grok-bot-opentorah-cloudflare-api-token.txt:OpenTorah/Keys/opentorah-cloudflare-api-token.txt
  CognoMath/Keys/grok-bot-cognomath-infra.json:CognoMath/Keys/terraform-cognomath-infra.json
  CognoMath/Keys/grok-bot-cognomath-cloudflare-api-token.txt:CognoMath/Keys/cognomath-cloudflare-api-token.txt
)

# mode 0644. ~/.config/git/config includes the OpenTorah and CognoMath email files.
identity_files=(
  .config/git/config
  OpenTorah/.gitconfig
  CognoMath/.gitconfig
)

for pair in "${secret_pairs[@]}"; do
  src=${pair%%:*}
  if [[ ! -f $HOME/$src ]]; then
    printf 'missing %s\n' "$src" >&2
    exit 1
  fi
done

for f in "${identity_files[@]}"; do
  if [[ ! -f $HOME/$f ]]; then
    printf 'missing %s\n' "$f" >&2
    exit 1
  fi
done

ssh "$host" 'mkdir -p Podval/Keys OpenTorah/Keys CognoMath/Keys .config/git && chmod 700 Podval/Keys OpenTorah/Keys CognoMath/Keys'

for pair in "${secret_pairs[@]}"; do
  src=${pair%%:*}
  dest=${pair#*:}
  scp -q "$HOME/$src" "$host:$dest"
  ssh "$host" "chmod 600 $(printf '%q' "$dest")"
done

copy_mode() {
  local mode=$1
  shift
  local f chmod_cmd
  for f in "$@"; do
    scp -q "$HOME/$f" "$host:$f"
  done
  chmod_cmd="chmod $mode"
  for f in "$@"; do
    chmod_cmd+=" $(printf '%q' "$f")"
  done
  ssh "$host" "$chmod_cmd"
}

copy_mode 644 "${identity_files[@]}"

fail=0
for pair in "${secret_pairs[@]}"; do
  src=${pair%%:*}
  dest=${pair#*:}
  local_size=$(stat -c '%s' "$HOME/$src")
  remote_size=$(ssh "$host" "stat -c '%s' $(printf '%q' "$dest")")
  if [[ $local_size != "$remote_size" ]]; then
    printf 'size mismatch %s\n' "$dest" >&2
    fail=1
  fi
done

for f in "${identity_files[@]}"; do
  local_size=$(stat -c '%s' "$HOME/$f")
  remote_size=$(ssh "$host" "stat -c '%s' $(printf '%q' "$f")")
  if [[ $local_size != "$remote_size" ]]; then
    printf 'size mismatch %s\n' "$f" >&2
    fail=1
  fi
done

if [[ $fail -ne 0 ]]; then
  exit 1
fi

printf 'copied %s files to %s\n' "$((${#secret_pairs[@]} + ${#identity_files[@]}))" "$host"
