#!/bin/bash
# Copy Pulumi credentials and Git identity to the cloud-infrastructure guest.
# ssh host infra (Tailscale, YubiKey). Does not print file contents.
set -euo pipefail

host=infra
# mode 0600
secret_files=(
  Podval/Keys/terraform-podval-infra.json
  Podval/Keys/podval-cloudflare-api-token.txt
  OpenTorah/Keys/terraform-opentorah-infra.json
  OpenTorah/Keys/opentorah-cloudflare-api-token.txt
  CognoMath/Keys/terraform-cognomath-infra.json
  CognoMath/Keys/cognomath-cloudflare-api-token.txt
)
# mode 0644. ~/.config/git/config includes the OpenTorah and CognoMath email files.
identity_files=(
  .config/git/config
  OpenTorah/.gitconfig
  CognoMath/.gitconfig
)

for f in "${secret_files[@]}" "${identity_files[@]}"; do
  if [[ ! -f $HOME/$f ]]; then
    printf 'missing %s\n' "$f" >&2
    exit 1
  fi
done

ssh "$host" 'mkdir -p Podval/Keys OpenTorah/Keys CognoMath/Keys .config/git && chmod 700 Podval/Keys OpenTorah/Keys CognoMath/Keys'

copy_mode() {
  local mode=$1
  shift
  local f chmod_cmd
  for f in "$@"; do
    scp -q "$HOME/$f" "$host:$f"
  done
  chmod_cmd="chmod $mode"
  for f in "$@"; do
    chmod_cmd+=" $(printf '%q' "$f")"
  done
  ssh "$host" "$chmod_cmd"
}

copy_mode 600 "${secret_files[@]}"
copy_mode 644 "${identity_files[@]}"

fail=0
for f in "${secret_files[@]}" "${identity_files[@]}"; do
  local_size=$(stat -c '%s' "$HOME/$f")
  remote_size=$(ssh "$host" "stat -c '%s' $(printf '%q' "$f")")
  if [[ $local_size != "$remote_size" ]]; then
    printf 'size mismatch %s\n' "$f" >&2
    fail=1
  fi
done

if [[ $fail -ne 0 ]]; then
  exit 1
fi

printf 'copied %s files to %s\n' "$((${#secret_files[@]} + ${#identity_files[@]}))" "$host"
